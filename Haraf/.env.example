# Copy to .env for local development. Values here contain no production secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=
# Example local value if MongoDB is installed and running:
# MONGODB_URI=mongodb://127.0.0.1:27017/harf

# Browser origin used by the app and exact browser origins allowed by the API.
APP_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# API requests use the same origin by default. Set to an absolute HTTPS URL only
# when the frontend and API are intentionally deployed on separate HTTPS origins.
VITE_API_BASE_URL=

# Vite development proxy target; configure for the local API listener.
VITE_DEV_API_TARGET=http://127.0.0.1:4000

# Uploaded media is stored outside this project by default. Keep the directory
# private from static web hosting and back it up according to your operations plan.
MEDIA_STORAGE_DIR=

# Optional local HTTPS testing. Use a trusted local certificate and keep the
# private key outside version control; both paths must be provided together.
VITE_HTTPS_KEY_FILE=
VITE_HTTPS_CERT_FILE=

# false is safest unless the app is actually behind a trusted reverse proxy.
# Set to a specific proxy address/subnet or a reviewed Express trust-proxy preset.
TRUST_PROXY=false
LOG_LEVEL=info

# SMTP is required to send verification and recovery links. Use an approved
# mail provider in production. Do not put real credentials in this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Jitsi IFrame API host and server-enforced join window (minutes).
# meet.jit.si does not guarantee room access is limited to booking participants.
JITSI_DOMAIN=meet.jit.si
JITSI_PARENT_EARLY_JOIN_MINUTES=10
JITSI_SPECIALIST_EARLY_JOIN_MINUTES=15
JITSI_POST_APPOINTMENT_GRACE_MINUTES=30
VIDEO_TEST_LIFETIME_MINUTES=30
